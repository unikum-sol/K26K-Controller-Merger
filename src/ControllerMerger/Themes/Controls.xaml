<!--
  K26K Controller Merger – Design-System: Typografie, Flächen und Controls.
  Regeln: 4-px-Raster, Radius 6 (Controls) / 10 (Karten) / 12 (Popups), eine Akzentfarbe,
  Farben ausschließlich über DynamicResource-Tokens (Themes/Dark.xaml, Themes/Light.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:ControllerMerger.UI">

  <!-- ============================================================ Grundlagen -->
  <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <ui:EqualsConverter x:Key="Equals" />
  <ui:BoolToVisibilityConverter x:Key="BoolToVis" />
  <ui:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />

  <Style x:Key="FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="8" RadiusY="8" StrokeThickness="2"
                     Stroke="{DynamicResource Brush.Focus}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ Typografie -->
  <Style x:Key="Text" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Text.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Text}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.PageLead" TargetType="TextBlock" BasedOn="{StaticResource Text}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <Style x:Key="Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Text}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Margin" Value="2,28,0,10" />
  </Style>
  <Style x:Key="Text.CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Text}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.Strong" TargetType="TextBlock" BasedOn="{StaticResource Text}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style x:Key="Text.Wrap" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text}">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>
  <Style x:Key="Text.Metric" TargetType="TextBlock" BasedOn="{StaticResource Text}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ============================================================ Flächen -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="20,18" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="Card.List" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Divider}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="IconTile" TargetType="Border">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.AccentText}" />
  </Style>
  <Style x:Key="IconTile.Small" TargetType="Border" BasedOn="{StaticResource IconTile}">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>

  <!-- Monogramm-Kachel je Controller-Familie (PS, XB, NS …). Größe kommt vom ContentControl. -->
  <DataTemplate x:Key="PadTile">
    <Border x:Name="tile" CornerRadius="9" Background="{DynamicResource Brush.SurfaceSubtle}" SnapsToDevicePixels="True">
      <Grid>
        <TextBlock x:Name="mono" Text="{Binding Monogram}" FontFamily="{StaticResource Font.UI}" FontSize="12"
                   FontWeight="Bold" Foreground="{DynamicResource Brush.TextTertiary}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock x:Name="glyph" Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="15" Visibility="Collapsed"
                   Foreground="{DynamicResource Brush.TextTertiary}" />
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Monogram}" Value="">
        <Setter TargetName="mono" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="glyph" Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsEnabled}" Value="True">
        <Setter TargetName="tile" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
        <Setter TargetName="mono" Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
        <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- ============================================================ Status-Pille -->
  <Style TargetType="ui:StatusBadge">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:StatusBadge">
          <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="9,3,10,4" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,1,7,0" />
              <TextBlock Text="{TemplateBinding Text}" FontFamily="{StaticResource Font.UI}" FontSize="12"
                         FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Kind" Value="Success">
        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
      </Trigger>
      <Trigger Property="Kind" Value="Warning">
        <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
      </Trigger>
      <Trigger Property="Kind" Value="Danger">
        <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
      </Trigger>
      <Trigger Property="Kind" Value="Accent">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================================================ Buttons -->
  <Style x:Key="Button" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.StrokeStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ui:Ui.HoverBackground" Value="{DynamicResource Brush.SurfaceHover}" />
    <Setter Property="ui:Ui.PressedBackground" Value="{DynamicResource Brush.SurfacePressed}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding ui:Ui.CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock x:Name="icon" Text="{TemplateBinding ui:Ui.Icon}" FontFamily="{StaticResource Font.Icons}"
                         FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
              <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ui:Ui.Icon" Value="{x:Null}">
              <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background"
                      Value="{Binding (ui:Ui.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background"
                      Value="{Binding (ui:Ui.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button}">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ui:Ui.HoverBackground" Value="{DynamicResource Brush.AccentHover}" />
    <Setter Property="ui:Ui.PressedBackground" Value="{DynamicResource Brush.AccentPressed}" />
  </Style>

  <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <!-- Neutral im Ruhezustand, Rot erst beim Überfahren (z. B. "Beenden") -->
  <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="ui:Ui.HoverBackground" Value="{DynamicResource Brush.DangerSubtle}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Button.Link" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="ui:Ui.HoverBackground" Value="{DynamicResource Brush.AccentSubtle}" />
  </Style>

  <!-- Titelleisten-Buttons (eigene Fensterleiste) -->
  <Style x:Key="Button.Caption" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="ui:Ui.HoverBackground" Value="{DynamicResource Brush.CaptionHover}" />
    <Setter Property="ui:Ui.HoverForeground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent">
            <TextBlock x:Name="glyph" Text="{TemplateBinding Content}" FontFamily="{StaticResource Font.Icons}" FontSize="10"
                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background"
                      Value="{Binding (ui:Ui.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="glyph" Property="Foreground"
                      Value="{Binding (ui:Ui.HoverForeground), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Button.CaptionClose" TargetType="Button" BasedOn="{StaticResource Button.Caption}">
    <Setter Property="ui:Ui.HoverBackground" Value="{DynamicResource Brush.CloseHover}" />
    <Setter Property="ui:Ui.HoverForeground" Value="White" />
  </Style>

  <!-- ============================================================ Toggle-Schalter -->
  <Style x:Key="Toggle" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter x:Name="label" VerticalAlignment="Center" Margin="0,0,10,0" />
            <!-- Aus: Kontur + Knopf in ControlStroke (≥ 3:1), An: Akzentfläche -->
            <Border x:Name="track" Grid.Column="1" Width="40" Height="20" CornerRadius="10"
                    Background="Transparent" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.ControlStroke}"
                    SnapsToDevicePixels="True">
              <Ellipse x:Name="knob" Width="10" Height="10" Margin="4,0" HorizontalAlignment="Left"
                       Fill="{DynamicResource Brush.ControlStroke}" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="label" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="knob" Property="Width" Value="12" />
              <Setter TargetName="knob" Property="Height" Value="12" />
              <Setter TargetName="knob" Property="Margin" Value="3,0" />
              <Setter TargetName="track" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="knob" Property="Fill" Value="{DynamicResource Brush.OnAccent}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="track" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Schalter mit "Ein"/"Aus"-Beschriftung wie in den Windows-Einstellungen (eindeutig auch für Laien) -->
  <Style x:Key="Toggle.OnOff" TargetType="CheckBox" BasedOn="{StaticResource Toggle}">
    <Setter Property="Content" Value="{ui:T Off}" />
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Content" Value="{ui:T On}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Dezenter Aufzählungspunkt für feste Regeln (bewusst kein Häkchen – keine Option) -->
  <Style x:Key="Bullet" TargetType="Ellipse">
    <Setter Property="Width" Value="5" />
    <Setter Property="Height" Value="5" />
    <Setter Property="Fill" Value="{DynamicResource Brush.TextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="2,7,12,0" />
  </Style>

  <!-- Kleiner Lade-Spinner (Kreisbogen), dreht sich, sobald er sichtbar ist -->
  <Style x:Key="Spinner" TargetType="Path">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="Data" Value="M 7,1 A 6,6 0 1 1 1,7" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform">
      <Setter.Value>
        <RotateTransform />
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsVisible" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard x:Name="spin">
            <Storyboard RepeatBehavior="Forever">
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                               From="0" To="360" Duration="0:0:0.9" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <StopStoryboard BeginStoryboardName="spin" />
        </Trigger.ExitActions>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================================================ Slider -->
  <Style x:Key="Slider.Fill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <Border Height="4" CornerRadius="2,0,0,2" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Slider.Empty" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <Border Height="4" CornerRadius="0,2,2,0" Background="{DynamicResource Brush.Track}" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Slider.Thumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Width="20" Height="20" Background="Transparent">
            <Ellipse Fill="{DynamicResource Brush.Thumb}" Stroke="{DynamicResource Brush.StrokeStrong}" StrokeThickness="1" />
            <Ellipse x:Name="dot" Width="10" Height="10" Fill="{DynamicResource Brush.Accent}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="dot" Property="Width" Value="12" />
              <Setter TargetName="dot" Property="Height" Value="12" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="dot" Property="Width" Value="8" />
              <Setter TargetName="dot" Property="Height" Value="8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="IsSnapToTickEnabled" Value="True" />
    <Setter Property="TickFrequency" Value="1" />
    <Setter Property="SmallChange" Value="1" />
    <Setter Property="LargeChange" Value="5" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="24" Background="Transparent">
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource Slider.Fill}" Command="Slider.DecreaseLarge" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource Slider.Empty}" Command="Slider.IncreaseLarge" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource Slider.Thumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ Segmented Control -->
  <Style x:Key="SegmentHost" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="MinWidth" Value="84" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                  CornerRadius="6" Padding="14,5" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SegmentSelected}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.SegmentStroke}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ Navigation -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="Transparent" CornerRadius="6" SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="indicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                      Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
              <StackPanel Orientation="Horizontal" Margin="14,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="icon" Text="{TemplateBinding ui:Ui.Icon}" FontFamily="{StaticResource Font.Icons}"
                           FontSize="15" Width="18" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.NavSelected}" />
              <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
              <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ Einstellungszeile -->
  <Style TargetType="ui:SettingRow">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="20,16" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:SettingRow">
          <Grid Margin="{TemplateBinding Padding}" Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
              <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.Strong}" FontWeight="Medium" />
              <TextBlock Text="{TemplateBinding Description}" Style="{StaticResource Text.Wrap}" Margin="0,3,0,0"
                         Visibility="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToCollapsed}}" />
            </StackPanel>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ Fortschritt -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Track}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border CornerRadius="2" Background="{TemplateBinding Background}" ClipToBounds="True">
            <Grid x:Name="PART_Track">
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="{TemplateBinding Foreground}" />
              <Border x:Name="runner" Width="90" HorizontalAlignment="Left" CornerRadius="2"
                      Background="{TemplateBinding Foreground}" Visibility="Collapsed">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="runnerShift" X="-90" />
                </Border.RenderTransform>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="runner" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="run">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="runnerShift" Storyboard.TargetProperty="X"
                                     From="-90" To="520" Duration="0:0:1.4">
                      <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="run" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ Scrollbar (schmal, unaufdringlich) -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="bd" CornerRadius="3" Background="{DynamicResource Brush.StrokeStrong}" Margin="1,0" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.TextTertiary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb Style="{StaticResource ScrollThumb}" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ Tooltip -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.StrokeStrong}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="6" Padding="10,6">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
