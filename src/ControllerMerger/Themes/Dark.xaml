<!--
  Design-Tokens: Dunkel. Gedämpftes, kühles Neutralgrau statt Reinschwarz (augenschonend),
  eine einzige Akzentfarbe, semantische Farben nur für Zustände.
  Kontraste (auf Karte #1C1F23): Text 13,8:1 · Sekundär 8,0:1 · Tertiär 5,6:1 · Nicht-Text ≥ 3:1.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.Window">#141619</Color>
  <Color x:Key="Color.Shadow">#000000</Color>

  <SolidColorBrush x:Key="Brush.Window" Color="#141619" />
  <SolidColorBrush x:Key="Brush.Sidebar" Color="#181A1E" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#1C1F23" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#23262B" />
  <SolidColorBrush x:Key="Brush.SurfaceSubtle" Color="#25292E" />
  <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#2B2F35" />
  <SolidColorBrush x:Key="Brush.Stroke" Color="#2B2F35" />
  <SolidColorBrush x:Key="Brush.StrokeStrong" Color="#3D434B" />
  <SolidColorBrush x:Key="Brush.Divider" Color="#262A2F" />

  <SolidColorBrush x:Key="Brush.Text" Color="#E7E9EC" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#B3B9C2" />
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="#8E96A1" />

  <SolidColorBrush x:Key="Brush.Accent" Color="#7DA4FF" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#93B3FF" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#6B93EF" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="#0D1424" />
  <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#1F2A42" />
  <SolidColorBrush x:Key="Brush.AccentText" Color="#A3BEFF" />

  <SolidColorBrush x:Key="Brush.Success" Color="#56C894" />
  <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="#172A21" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#E8BA5C" />
  <SolidColorBrush x:Key="Brush.WarningSubtle" Color="#2D2516" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#F2837F" />
  <SolidColorBrush x:Key="Brush.DangerSubtle" Color="#321D1F" />

  <!-- Bedienelemente (Nicht-Text-Kontrast ≥ 3:1) -->
  <SolidColorBrush x:Key="Brush.ControlStroke" Color="#8E96A1" />
  <SolidColorBrush x:Key="Brush.Thumb" Color="#E7E9EC" />
  <SolidColorBrush x:Key="Brush.Track" Color="#6F7680" />
  <SolidColorBrush x:Key="Brush.Footer" Color="#181A1E" />
  <SolidColorBrush x:Key="Brush.Focus" Color="#93B3FF" />
  <SolidColorBrush x:Key="Brush.SegmentSelected" Color="#353A42" />
  <SolidColorBrush x:Key="Brush.SegmentStroke" Color="#4A5059" />
  <SolidColorBrush x:Key="Brush.NavSelected" Color="#232A38" />

  <SolidColorBrush x:Key="Brush.CaptionHover" Color="#26292E" />
  <SolidColorBrush x:Key="Brush.CloseHover" Color="#C42B1C" />
</ResourceDictionary>
