<!--
  Design-Tokens: Hell. Gleiche Schlüssel wie Dark.xaml – Controls verwenden ausschließlich DynamicResource.
  Kontraste (auf Weiß): Text 17:1 · Sekundär 8,1:1 · Tertiär 5,3:1 · Erfolg 5,3:1 · Nicht-Text ≥ 3:1.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.Window">#F3F4F6</Color>
  <Color x:Key="Color.Shadow">#1A2233</Color>

  <SolidColorBrush x:Key="Brush.Window" Color="#F3F4F6" />
  <SolidColorBrush x:Key="Brush.Sidebar" Color="#FAFAFB" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#F5F6F8" />
  <SolidColorBrush x:Key="Brush.SurfaceSubtle" Color="#EEF0F3" />
  <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#E5E8EC" />
  <SolidColorBrush x:Key="Brush.Stroke" Color="#E1E4E8" />
  <SolidColorBrush x:Key="Brush.StrokeStrong" Color="#C9CED6" />
  <SolidColorBrush x:Key="Brush.Divider" Color="#ECEEF1" />

  <SolidColorBrush x:Key="Brush.Text" Color="#16191D" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#4A515C" />
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="#666D78" />

  <SolidColorBrush x:Key="Brush.Accent" Color="#2F62E9" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#2756D6" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#1F48B8" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#E8EEFC" />
  <SolidColorBrush x:Key="Brush.AccentText" Color="#2350C8" />

  <SolidColorBrush x:Key="Brush.Success" Color="#1A7A4E" />
  <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="#E3F3EA" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#94600E" />
  <SolidColorBrush x:Key="Brush.WarningSubtle" Color="#FBF1DE" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#C2343A" />
  <SolidColorBrush x:Key="Brush.DangerSubtle" Color="#FBE8E8" />

  <!-- Bedienelemente (Nicht-Text-Kontrast ≥ 3:1) -->
  <SolidColorBrush x:Key="Brush.ControlStroke" Color="#6B7280" />
  <SolidColorBrush x:Key="Brush.Thumb" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Track" Color="#858C97" />
  <SolidColorBrush x:Key="Brush.Footer" Color="#EBEDF0" />
  <SolidColorBrush x:Key="Brush.Focus" Color="#2F62E9" />
  <SolidColorBrush x:Key="Brush.SegmentSelected" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.SegmentStroke" Color="#C9CED6" />
  <SolidColorBrush x:Key="Brush.NavSelected" Color="#E6ECFB" />

  <SolidColorBrush x:Key="Brush.CaptionHover" Color="#E8EAEE" />
  <SolidColorBrush x:Key="Brush.CloseHover" Color="#C42B1C" />
</ResourceDictionary>
