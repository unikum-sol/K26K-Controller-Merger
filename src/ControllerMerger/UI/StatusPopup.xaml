<Window x:Class="ControllerMerger.UI.StatusPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ControllerMerger.UI"
        Title="ControllerMerger – Status"
        Width="384" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

  <Window.Resources>
    <DataTemplate x:Key="PopupPadRow">
      <Grid Margin="18,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="32" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ContentControl Width="32" Height="32" Content="{Binding}" ContentTemplate="{StaticResource PadTile}" Focusable="False" />
        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
          <TextBlock x:Name="name" Style="{StaticResource Text.Strong}" Text="{Binding Name}" />
          <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Detail}" Margin="0,2,0,0" />
        </StackPanel>
        <TextBlock x:Name="paused" Grid.Column="2" Style="{StaticResource Text.Secondary}" Text="Pausiert"
                   VerticalAlignment="Center" Visibility="Collapsed" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
          <Setter TargetName="name" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
          <Setter TargetName="paused" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root" Margin="12">
    <!-- Schatten als eigene Ebene, damit der Text nicht durch den Effekt weichgezeichnet wird -->
    <Border CornerRadius="12" Background="{DynamicResource Brush.Surface}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.30"
                          Color="{DynamicResource Color.Shadow}" />
      </Border.Effect>
    </Border>

    <Border CornerRadius="12" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.StrokeStrong}" BorderThickness="1">
      <StackPanel>
        <!-- Kopf: App + Gesamtzustand -->
        <Grid Margin="18,16,16,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image x:Name="AppMark" Width="32" Height="32" />
          <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Text.CardTitle}" Text="ControllerMerger" />
            <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding HeaderSummary}" Margin="0,2,0,0" />
          </StackPanel>
          <ui:StatusBadge Grid.Column="2" Kind="{Binding StatusKind}" Text="{Binding StatusText}" />
        </Grid>

        <Border Style="{StaticResource Divider}" />

        <!-- Normalbetrieb -->
        <StackPanel Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
          <TextBlock Style="{StaticResource Text.Caption}" Text="Für Spiele sichtbar" Margin="18,12,18,6" />
          <Grid Margin="18,0,18,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Brush.Accent}">
              <TextBlock Style="{StaticResource Text}" Text="360" FontSize="11.5" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Strong}" Text="Virtueller Xbox 360 Controller" />
              <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding PlayerText}" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>

          <Border Style="{StaticResource Divider}" />

          <Grid Margin="18,12,18,4">
            <TextBlock Style="{StaticResource Text.Caption}" Text="Deine Controller" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding PadsSummary}" HorizontalAlignment="Right" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Pads}" ItemTemplate="{StaticResource PopupPadRow}" Focusable="False" Margin="0,0,0,8"
                        Visibility="{Binding HasPads, Converter={StaticResource BoolToVis}}" />
          <TextBlock Style="{StaticResource Text.Wrap}" Margin="18,4,18,14"
                     Text="Noch keiner verbunden. Schließe einen Controller per USB oder Bluetooth an."
                     Visibility="{Binding HasPads, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
        </StackPanel>

        <!-- Problem: eine Meldung, eine Handlung -->
        <StackPanel Margin="18,16,18,16" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="15" Foreground="{DynamicResource Brush.Danger}" Margin="0,0,10,0" />
            <TextBlock Style="{StaticResource Text.Strong}" Text="{Binding ProblemTitle}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Style="{StaticResource Text.Wrap}" Text="{Binding ProblemText}" Margin="25,4,0,0" />
          <Button Style="{StaticResource Button.Primary}" Content="Treiber einrichten" HorizontalAlignment="Left" Margin="25,12,0,0"
                  Command="{Binding RepairDriverCommand}" Click="OnActionClick"
                  Visibility="{Binding CanRepair, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <Border Style="{StaticResource Divider}" />

        <!-- Aktionen -->
        <Grid Margin="8">
          <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" ui:Ui.Icon="&#xE713;"
                  Content="Einstellungen öffnen" Command="{Binding OpenSettingsCommand}" Click="OnActionClick" />
          <!-- Destruktive Aktion: Symbol in Rot als Hinweis, Text ruhig; volle Rot-Fläche erst beim Überfahren -->
          <Button Style="{StaticResource Button.Danger}" HorizontalAlignment="Right" Command="{Binding ExitCommand}"
                  Click="OnActionClick" ToolTip="Beendet ControllerMerger. Der virtuelle Controller wird entfernt.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="14" Foreground="{DynamicResource Brush.Danger}" Margin="0,0,8,0" />
              <TextBlock Text="Beenden" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
