<Window x:Class="ControllerMerger.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ControllerMerger.UI"
        Title="{ui:T SettingsTitle}"
        Width="920" Height="680" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Controller-Zeile in der Übersicht: Kachel 40 · Abstand 16 · Name/Details · zwei beschriftete Schalter -->
    <DataTemplate x:Key="PadRow">
      <StackPanel>
        <Border x:Name="sep" Style="{StaticResource Divider}" Margin="76,0,0,0" />
        <Grid Margin="20,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ContentControl Width="40" Height="40" Content="{Binding}" ContentTemplate="{StaticResource PadTile}" Focusable="False" />
          <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
            <TextBlock x:Name="name" Style="{StaticResource Text.Strong}" Text="{Binding Name}" />
            <TextBlock x:Name="detail" Style="{StaticResource Text.Secondary}" Text="{Binding Detail}" Margin="0,3,0,0" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:T PadNotHideable}" Margin="0,3,0,0" TextWrapping="Wrap"
                       Visibility="{Binding ShowNotHideable, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
          <!-- Beschriftete Schalter; feste Labelbreite, damit Beschriftungen und Schalter bündig stehen -->
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding IsEnabled}" ToolTip="{ui:T PadToggleTip}"
                      AutomationProperties.Name="{ui:T PadUseInput}">
              <TextBlock Text="{ui:T PadUseInput}" Width="80" />
            </CheckBox>
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding IsHidden}" Margin="0,8,0,0" ToolTip="{Binding HideTip}"
                      AutomationProperties.Name="{ui:T PadHide}"
                      Visibility="{Binding ShowHideSwitch, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{ui:T PadHide}" Width="80" />
            </CheckBox>
          </StackPanel>
        </Grid>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsFirst}" Value="True">
          <Setter TargetName="sep" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
          <Setter TargetName="name" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Chip im Hero: welcher Controller gerade mitsteuert -->
    <DataTemplate x:Key="PadChip">
      <Border CornerRadius="8" Background="{DynamicResource Brush.SurfaceSubtle}" Padding="4,4,12,4" Margin="0,0,8,8">
        <StackPanel Orientation="Horizontal">
          <ContentControl Width="24" Height="24" Content="{Binding}" ContentTemplate="{StaticResource PadTile}" Focusable="False" />
          <TextBlock Style="{StaticResource Text}" FontSize="12.5" FontWeight="SemiBold" Text="{Binding Name}"
                     VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Frame" Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.StrokeStrong}">
    <Grid x:Name="Root">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="232" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ===================================================== Seitenleiste -->
      <Border Grid.RowSpan="2" Background="{DynamicResource Brush.Sidebar}"
              BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,0,1,0" />

      <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
        <Image x:Name="AppMark" Width="18" Height="18" />
        <TextBlock Style="{StaticResource Text.Strong}" Text="K26K Controller Merger" Margin="10,0,0,0" FontSize="12.5"
                   VerticalAlignment="Center" />
      </StackPanel>

      <DockPanel Grid.Row="1" Margin="12,14,12,16" LastChildFill="False">
        <StackPanel DockPanel.Dock="Top">
          <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" ui:Ui.Icon="&#xE80F;" Content="{ui:T NavOverview}"
                       GroupName="nav" IsChecked="True" Checked="OnNavChecked" />
          <RadioButton x:Name="NavInput" Style="{StaticResource NavItem}" ui:Ui.Icon="&#xE7FC;" Content="{ui:T NavInput}"
                       GroupName="nav" Checked="OnNavChecked" />
          <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" ui:Ui.Icon="&#xE713;" Content="{ui:T NavGeneral}"
                       GroupName="nav" Checked="OnNavChecked" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" Text="{Binding AppVersionText}" Margin="14,0,0,0" />
      </DockPanel>

      <!-- ===================================================== Titelleiste rechts -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="OnMinimize"
                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{ui:T Minimize}" />
        <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="OnClose"
                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{ui:T Close}" />
      </StackPanel>

      <!-- ===================================================== Inhalt (eine feste Breite für alle Seiten) -->
      <ScrollViewer x:Name="Scroller" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid x:Name="ContentHost" Margin="48,6,48,40" HorizontalAlignment="Left" Width="600">

          <!-- ================================================= Übersicht -->
          <StackPanel x:Name="PageOverview">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="{ui:T NavOverview}" />
            <TextBlock Style="{StaticResource Text.PageLead}"
                       Text="{ui:T OvLead}" />

            <!-- Hero: N Controller → 1 virtueller Controller -->
            <Border Style="{StaticResource Card.List}" Margin="0,24,0,0">
              <StackPanel>
                <Grid Margin="20,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <!-- Eigene Kennung des virtuellen Controllers ("360") – das Gamepad-Symbol bleibt der App vorbehalten -->
                  <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.Accent}">
                    <TextBlock Style="{StaticResource Text}" Text="360" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T VirtualController}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding VirtualDetail}" Margin="0,3,0,0" />
                  </StackPanel>
                  <ui:StatusBadge Grid.Column="2" Kind="{Binding StatusKind}" Text="{Binding StatusText}" />
                </Grid>

                <Border Style="{StaticResource Divider}" Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}" />
                <StackPanel Margin="20,14,20,10" Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
                  <TextBlock Style="{StaticResource Text.Secondary}" Text="{ui:T OvControlledBy}" Margin="0,0,0,10" />
                  <ItemsControl ItemsSource="{Binding Pads}" ItemTemplate="{StaticResource PadChip}" Focusable="False"
                                Visibility="{Binding HasActivePads, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                  </ItemsControl>
                  <TextBlock Style="{StaticResource Text}" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,0,0,8"
                             Text="{ui:T OvNoActive}"
                             Visibility="{Binding HasActivePads, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </StackPanel>

                <!-- Problem: genau eine Meldung + eine Handlung -->
                <Border Style="{StaticResource Divider}" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}" />
                <Grid Margin="20,16,20,18" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="18" Foreground="{DynamicResource Brush.Danger}" />
                  <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Strong}" Text="{Binding ProblemTitle}" />
                    <TextBlock Style="{StaticResource Text.Wrap}" Text="{Binding ProblemText}" Margin="0,3,0,0" />
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Content="{ui:T SetupDriver}"
                          Command="{Binding RepairDriverCommand}" VerticalAlignment="Center"
                          Visibility="{Binding CanRepair, Converter={StaticResource BoolToVis}}" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Physische Controller (im Fehlerzustand ausgeblendet: dann zählt nur die eine Handlung oben) -->
            <StackPanel Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
            <Grid>
              <TextBlock Style="{StaticResource Text.Section}" Text="{ui:T YourControllers}" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding PadsSummary}" HorizontalAlignment="Right"
                         VerticalAlignment="Bottom" Margin="0,0,2,11" />
            </Grid>

            <!-- Verstecken (HidHide): genau eine Karte je Zustand, nur wenn Controller da sind -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12"
                    Visibility="{Binding ShowHideSetup, Converter={StaticResource BoolToVis}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Auge mit Querstrich (Glyphe fehlt unter Windows 10, daher zusammengesetzt) -->
                <Border Style="{StaticResource IconTile}" VerticalAlignment="Top">
                  <Grid Width="18" Height="18">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE890;" FontSize="16" />
                    <Line X1="2" Y1="16" X2="16" Y2="2" StrokeThickness="3.5" Stroke="{DynamicResource Brush.AccentSubtle}" />
                    <Line X1="2" Y1="16" X2="16" Y2="2" StrokeThickness="1.4"
                          Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Text.Strong}" Text="{ui:T HhSetupTitle}" />
                  <TextBlock Style="{StaticResource Text.Wrap}" Text="{ui:T HhSetupText}" Margin="0,3,0,0" />
                  <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:T HhSetupCaption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                  <TextBlock Style="{StaticResource Text.Wrap}" Text="{Binding HideInstallError}" Margin="0,6,0,0"
                             Foreground="{DynamicResource Brush.Danger}"
                             Visibility="{Binding HasHideInstallError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Content="{Binding HideInstallButtonText}"
                        Command="{Binding InstallHidHideCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12"
                    Visibility="{Binding ShowHideRestart, Converter={StaticResource BoolToVis}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconTile}" VerticalAlignment="Top" Background="{DynamicResource Brush.WarningSubtle}"
                        TextElement.Foreground="{DynamicResource Brush.Warning}">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="16" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Text.Strong}" Text="{ui:T HhRestartTitle}" />
                  <TextBlock Style="{StaticResource Text.Wrap}" Text="{ui:T HhRestartText}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Button}" Content="{ui:T HhRestartButton}"
                        Command="{Binding RestartWindowsCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12"
                    Visibility="{Binding ShowHideProblem, Converter={StaticResource BoolToVis}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="18" Foreground="{DynamicResource Brush.Warning}"
                           VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Text.Strong}" Text="{ui:T HhProblemTitle}" />
                  <TextBlock Style="{StaticResource Text.Wrap}" Text="{Binding HideProblemText}" Margin="0,3,0,0" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card.List}" Visibility="{Binding HasPads, Converter={StaticResource BoolToVis}}">
              <ItemsControl ItemsSource="{Binding Pads}" ItemTemplate="{StaticResource PadRow}" Focusable="False" />
            </Border>

            <Border Style="{StaticResource Card}" Padding="24,28"
                    Visibility="{Binding HasPads, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
              <StackPanel HorizontalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Brush.SurfaceSubtle}" HorizontalAlignment="Center">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="18" Foreground="{DynamicResource Brush.TextTertiary}" />
                </Border>
                <TextBlock Style="{StaticResource Text.Strong}" Text="{ui:T OvEmptyTitle}" Margin="0,14,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Text.Wrap}" TextAlignment="Center" MaxWidth="360" Margin="0,6,0,0"
                           Text="{ui:T OvEmptyText}" />
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Caption}" Margin="2,12,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasPads, Converter={StaticResource BoolToVis}}"
                       Text="{ui:T OvFootnote}" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="2,4,0,0" TextWrapping="Wrap"
                       Visibility="{Binding ShowHideFootnote, Converter={StaticResource BoolToVis}}"
                       Text="{ui:T OvFootnoteHide}" />
            </StackPanel>
          </StackPanel>

          <!-- ================================================= Eingabe -->
          <StackPanel x:Name="PageInput" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="{ui:T NavInput}" />
            <TextBlock Style="{StaticResource Text.PageLead}"
                       Text="{ui:T InLead}" />

            <TextBlock Style="{StaticResource Text.Section}" Text="{ui:T InMerge}" Margin="2,24,0,10" />
            <Border Style="{StaticResource Card.List}">
              <StackPanel>
                <ui:SettingRow Title="{ui:T InSticks}" Description="{ui:T InSticksDesc}">
                  <Border Style="{StaticResource SegmentHost}">
                    <UniformGrid Rows="1">
                      <RadioButton Style="{StaticResource Segment}" Content="{ui:T InWholeStick}" GroupName="stickmode"
                                   IsChecked="{Binding StickMode, Converter={StaticResource Equals}, ConverterParameter=PerStick}" />
                      <RadioButton Style="{StaticResource Segment}" Content="{ui:T InPerAxis}" GroupName="stickmode"
                                   IsChecked="{Binding StickMode, Converter={StaticResource Equals}, ConverterParameter=PerAxis}" />
                    </UniformGrid>
                  </Border>
                </ui:SettingRow>
                <!-- Beide Optionen erklärt; die gewählte ist hervorgehoben -->
                <Grid Margin="20,0,20,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock x:Name="ModeStickName" Style="{StaticResource Text}" FontSize="12.5" Text="{ui:T InWholeStick}" Margin="0,0,16,6" />
                  <TextBlock x:Name="ModeStickText" Grid.Column="1" Style="{StaticResource Text.Wrap}" FontSize="12.5" Margin="0,0,0,6"
                             Text="{ui:T InWholeStickText}" />
                  <TextBlock x:Name="ModeAxisName" Grid.Row="1" Style="{StaticResource Text}" FontSize="12.5" Text="{ui:T InPerAxis}" Margin="0,0,16,0" />
                  <TextBlock x:Name="ModeAxisText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Wrap}" FontSize="12.5"
                             Text="{ui:T InPerAxisText}" />
                </Grid>
                <Border Style="{StaticResource Divider}" />
                <StackPanel Margin="20,14,20,14">
                  <TextBlock Style="{StaticResource Text.Strong}" FontWeight="Medium" Text="{ui:T InOtherInputs}" Margin="0,0,0,8" />
                  <StackPanel>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Style="{StaticResource Bullet}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource Text.Wrap}" FontSize="12.5" Text="{ui:T RuleButtons}" />
                    </Grid>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Style="{StaticResource Bullet}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource Text.Wrap}" FontSize="12.5" Text="{ui:T RuleTriggers}" />
                    </Grid>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Style="{StaticResource Bullet}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource Text.Wrap}" FontSize="12.5" Text="{ui:T RuleDpad}" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Section}" Text="{ui:T InDeadzone}" />
            <Border Style="{StaticResource Card.List}">
              <StackPanel>
                <Grid Margin="20,16,20,14">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Strong}" FontWeight="Medium" Text="{ui:T InSticks}" />
                    <TextBlock Style="{StaticResource Text.Wrap}" Margin="0,3,0,0"
                               Text="{ui:T InStickDzDesc}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Style="{StaticResource Text.Strong}" VerticalAlignment="Top" Margin="16,0,0,0">
                    <Run Text="{Binding StickDeadzone, Mode=OneWay}" /><Run Text=" %" />
                  </TextBlock>
                  <Slider Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Minimum="0" Maximum="30"
                          Value="{Binding StickDeadzone}" AutomationProperties.Name="{ui:T InStickDzName}" />
                </Grid>
                <Border Style="{StaticResource Divider}" />
                <Grid Margin="20,16,20,14">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Strong}" FontWeight="Medium" Text="{ui:T InTriggers}" />
                    <TextBlock Style="{StaticResource Text.Wrap}" Margin="0,3,0,0"
                               Text="{ui:T InTriggerDzDesc}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Style="{StaticResource Text.Strong}" VerticalAlignment="Top" Margin="16,0,0,0">
                    <Run Text="{Binding TriggerDeadzone, Mode=OneWay}" /><Run Text=" %" />
                  </TextBlock>
                  <Slider Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Minimum="0" Maximum="30"
                          Value="{Binding TriggerDeadzone}" AutomationProperties.Name="{ui:T InTriggerDzName}" />
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Section}" Text="{ui:T InInvert}" />
            <Border Style="{StaticResource Card.List}">
              <StackPanel>
                <ui:SettingRow Title="{ui:T InLeftStick}" Description="{ui:T InLeftStickDesc}">
                  <StackPanel Orientation="Horizontal">
                    <CheckBox Style="{StaticResource Toggle}" Content="{ui:T InHorizontal}" IsChecked="{Binding InvertLeftX}" />
                    <CheckBox Style="{StaticResource Toggle}" Content="{ui:T InVertical}" IsChecked="{Binding InvertLeftY}" Margin="24,0,0,0" />
                  </StackPanel>
                </ui:SettingRow>
                <Border Style="{StaticResource Divider}" />
                <ui:SettingRow Title="{ui:T InRightStick}" Description="{ui:T InRightStickDesc}">
                  <StackPanel Orientation="Horizontal">
                    <CheckBox Style="{StaticResource Toggle}" Content="{ui:T InHorizontal}" IsChecked="{Binding InvertRightX}" />
                    <CheckBox Style="{StaticResource Toggle}" Content="{ui:T InVertical}" IsChecked="{Binding InvertRightY}" Margin="24,0,0,0" />
                  </StackPanel>
                </ui:SettingRow>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Section}" Text="{ui:T InResponse}" />
            <Border Style="{StaticResource Card.List}">
              <ui:SettingRow Title="{ui:T InInterval}" Description="{ui:T InIntervalDesc}">
                <Border Style="{StaticResource SegmentHost}">
                  <UniformGrid Rows="1">
                    <RadioButton Style="{StaticResource Segment}" MinWidth="58" Content="1 ms" GroupName="poll"
                                 IsChecked="{Binding PollingIntervalMs, Converter={StaticResource Equals}, ConverterParameter=1}" />
                    <RadioButton Style="{StaticResource Segment}" MinWidth="58" Content="2 ms" GroupName="poll"
                                 IsChecked="{Binding PollingIntervalMs, Converter={StaticResource Equals}, ConverterParameter=2}" />
                    <RadioButton Style="{StaticResource Segment}" MinWidth="58" Content="4 ms" GroupName="poll"
                                 IsChecked="{Binding PollingIntervalMs, Converter={StaticResource Equals}, ConverterParameter=4}" />
                    <RadioButton Style="{StaticResource Segment}" MinWidth="58" Content="8 ms" GroupName="poll"
                                 IsChecked="{Binding PollingIntervalMs, Converter={StaticResource Equals}, ConverterParameter=8}" />
                  </UniformGrid>
                </Border>
              </ui:SettingRow>
            </Border>
          </StackPanel>

          <!-- ================================================= Allgemein -->
          <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="{ui:T NavGeneral}" />
            <TextBlock Style="{StaticResource Text.PageLead}" Text="{ui:T GenLead}" />

            <TextBlock Style="{StaticResource Text.Section}" Text="{ui:T GenBehavior}" Margin="2,24,0,10" />
            <Border Style="{StaticResource Card.List}">
              <StackPanel>
                <ui:SettingRow Title="{ui:T GenRumble}"
                               Description="{ui:T GenRumbleDesc}">
                  <CheckBox Style="{StaticResource Toggle.OnOff}" IsChecked="{Binding RumbleEnabled}" AutomationProperties.Name="{ui:T GenRumble}" />
                </ui:SettingRow>
                <Border Style="{StaticResource Divider}" />
                <ui:SettingRow Title="{ui:T GenAutostart}"
                               Description="{ui:T GenAutostartDesc}">
                  <CheckBox Style="{StaticResource Toggle.OnOff}" IsChecked="{Binding Autostart}" AutomationProperties.Name="{ui:T GenAutostart}" />
                </ui:SettingRow>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Section}" Text="{ui:T GenAppearance}" />
            <Border Style="{StaticResource Card.List}">
              <StackPanel>
                <ui:SettingRow Title="{ui:T GenTheme}" Description="{ui:T GenThemeDesc}">
                  <Border Style="{StaticResource SegmentHost}">
                    <UniformGrid Rows="1">
                      <RadioButton Style="{StaticResource Segment}" MinWidth="72" Content="{ui:T ThemeSystem}" GroupName="theme"
                                   IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}" />
                      <RadioButton Style="{StaticResource Segment}" MinWidth="72" Content="{ui:T ThemeLight}" GroupName="theme"
                                   IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}" />
                      <RadioButton Style="{StaticResource Segment}" MinWidth="72" Content="{ui:T ThemeDark}" GroupName="theme"
                                   IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}" />
                    </UniformGrid>
                  </Border>
                </ui:SettingRow>
                <Border Style="{StaticResource Divider}" />
                <!-- Sprachnamen bewusst nicht übersetzt: jeder findet seine eigene Sprache -->
                <ui:SettingRow Title="{ui:T GenLanguage}" Description="{ui:T GenLanguageDesc}">
                  <Border Style="{StaticResource SegmentHost}">
                    <UniformGrid Rows="1">
                      <RadioButton Style="{StaticResource Segment}" MinWidth="72" Content="Deutsch" GroupName="language"
                                   IsChecked="{Binding Language, Converter={StaticResource Equals}, ConverterParameter=German}" />
                      <RadioButton Style="{StaticResource Segment}" MinWidth="72" Content="English" GroupName="language"
                                   IsChecked="{Binding Language, Converter={StaticResource Equals}, ConverterParameter=English}" />
                    </UniformGrid>
                  </Border>
                </ui:SettingRow>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Section}" Text="{ui:T GenTech}" />
            <Border Style="{StaticResource Card.List}">
              <StackPanel>
                <ui:SettingRow Title="{ui:T GenDriver}" Description="{ui:T GenDriverDesc}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,1,8,0" VerticalAlignment="Center">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding DriverOk}" Value="False">
                              <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource Text}" Text="{Binding DriverVersionText}" />
                  </StackPanel>
                </ui:SettingRow>
                <Border Style="{StaticResource Divider}" />
                <ui:SettingRow Title="{ui:T GenHidHide}" Description="{ui:T GenHidHideDesc}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,1,8,0" VerticalAlignment="Center">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HidHideOk}" Value="False">
                              <Setter Property="Fill" Value="{DynamicResource Brush.TextTertiary}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource Text}" Text="{Binding HidHideStatusText}" />
                  </StackPanel>
                </ui:SettingRow>
                <Border Style="{StaticResource Divider}" />
                <ui:SettingRow Title="{ui:T GenPort}" Description="{ui:T GenPortDesc}">
                  <TextBlock Style="{StaticResource Text}" Text="{Binding PlayerText}" />
                </ui:SettingRow>
                <Border Style="{StaticResource Divider}" />
                <ui:SettingRow Title="{ui:T GenRate}" Description="{ui:T GenRateDesc}">
                  <TextBlock Style="{StaticResource Text}" Text="{Binding RateText}" />
                </ui:SettingRow>
                <Border Style="{StaticResource Divider}" />
                <ui:SettingRow Title="{ui:T GenSdl}" Description="{ui:T GenSdlDesc}">
                  <TextBlock Style="{StaticResource Text}" Text="{Binding SdlVersionText}" />
                </ui:SettingRow>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Section}" Text="{ui:T GenHelp}" />
            <Border Style="{StaticResource Card}" Padding="20,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.SurfaceSubtle}" VerticalAlignment="Top">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource Brush.TextSecondary}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Text.Strong}" Text="{ui:T GenHelpTitle}" />
                  <TextBlock Style="{StaticResource Text.Wrap}" Margin="0,4,0,0"
                             Text="{ui:T GenHelpText}" />
                </StackPanel>
              </Grid>
            </Border>

            <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="-8,14,0,0" ui:Ui.Icon="&#xE8A7;"
                    Content="{ui:T GenOpenLog}" Command="{Binding OpenLogCommand}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
