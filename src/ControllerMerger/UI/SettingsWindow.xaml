<Window x:Class="ControllerMerger.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ControllerMerger.UI"
        Title="K26K Controller Merger – Einstellungen"
        Width="920" Height="680" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Controller-Zeile in der Übersicht: Kachel 40 · Abstand 16 · Name/Details · Schalter -->
    <DataTemplate x:Key="PadRow">
      <StackPanel>
        <Border x:Name="sep" Style="{StaticResource Divider}" Margin="76,0,0,0" />
        <Grid Margin="20,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ContentControl Width="40" Height="40" Content="{Binding}" ContentTemplate="{StaticResource PadTile}" Focusable="False" />
          <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
            <TextBlock x:Name="name" Style="{StaticResource Text.Strong}" Text="{Binding Name}" />
            <TextBlock x:Name="detail" Style="{StaticResource Text.Secondary}" Text="{Binding Detail}" Margin="0,3,0,0" />
          </StackPanel>
          <CheckBox Grid.Column="2" Style="{StaticResource Toggle.OnOff}" IsChecked="{Binding IsEnabled}"
                    AutomationProperties.Name="{Binding Name}" ToolTip="Eingaben dieses Controllers übernehmen" />
        </Grid>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsFirst}" Value="True">
          <Setter TargetName="sep" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
          <Setter TargetName="name" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Chip im Hero: welcher Controller gerade mitsteuert -->
    <DataTemplate x:Key="PadChip">
      <Border CornerRadius="8" Background="{DynamicResource Brush.SurfaceSubtle}" Padding="4,4,12,4" Margin="0,0,8,8">
        <StackPanel Orientation="Horizontal">
          <ContentControl Width="24" Height="24" Content="{Binding}" ContentTemplate="{StaticResource PadTile}" Focusable="False" />
          <TextBlock Style="{StaticResource Text}" FontSize="12.5" FontWeight="SemiBold" Text="{Binding Name}"
                     VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Frame" Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.StrokeStrong}">
    <Grid x:Name="Root">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="232" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ===================================================== Seitenleiste -->
      <Border Grid.RowSpan="2" Background="{DynamicResource Brush.Sidebar}"
              BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,0,1,0" />

      <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
        <Image x:Name="AppMark" Width="18" Height="18" />
        <TextBlock Style="{StaticResource Text.Strong}" Text="K26K Controller Merger" Margin="10,0,0,0" FontSize="12.5"
                   VerticalAlignment="Center" />
      </StackPanel>

      <DockPanel Grid.Row="1" Margin="12,14,12,16" LastChildFill="False">
        <StackPanel DockPanel.Dock="Top">
          <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" ui:Ui.Icon="&#xE80F;" Content="Übersicht"
                       GroupName="nav" IsChecked="True" Checked="OnNavChecked" />
          <RadioButton x:Name="NavInput" Style="{StaticResource NavItem}" ui:Ui.Icon="&#xE7FC;" Content="Eingabe"
                       GroupName="nav" Checked="OnNavChecked" />
          <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" ui:Ui.Icon="&#xE713;" Content="Allgemein"
                       GroupName="nav" Checked="OnNavChecked" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" Text="{Binding AppVersionText}" Margin="14,0,0,0" />
      </DockPanel>

      <!-- ===================================================== Titelleiste rechts -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="OnMinimize"
                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimieren" />
        <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="OnClose"
                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Schließen" />
      </StackPanel>

      <!-- ===================================================== Inhalt (eine feste Breite für alle Seiten) -->
      <ScrollViewer x:Name="Scroller" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid x:Name="ContentHost" Margin="48,6,48,40" HorizontalAlignment="Left" Width="600">

          <!-- ================================================= Übersicht -->
          <StackPanel x:Name="PageOverview">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="Übersicht" />
            <TextBlock Style="{StaticResource Text.PageLead}"
                       Text="Alle angeschlossenen Controller steuern gemeinsam einen virtuellen Xbox 360 Controller." />

            <!-- Hero: N Controller → 1 virtueller Controller -->
            <Border Style="{StaticResource Card.List}" Margin="0,24,0,0">
              <StackPanel>
                <Grid Margin="20,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <!-- Eigene Kennung des virtuellen Controllers ("360") – das Gamepad-Symbol bleibt der App vorbehalten -->
                  <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.Accent}">
                    <TextBlock Style="{StaticResource Text}" Text="360" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.CardTitle}" Text="Virtueller Xbox 360 Controller" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding VirtualDetail}" Margin="0,3,0,0" />
                  </StackPanel>
                  <ui:StatusBadge Grid.Column="2" Kind="{Binding StatusKind}" Text="{Binding StatusText}" />
                </Grid>

                <Border Style="{StaticResource Divider}" Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}" />
                <StackPanel Margin="20,14,20,10" Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
                  <TextBlock Style="{StaticResource Text.Secondary}" Text="Gesteuert von" Margin="0,0,0,10" />
                  <ItemsControl ItemsSource="{Binding Pads}" ItemTemplate="{StaticResource PadChip}" Focusable="False"
                                Visibility="{Binding HasActivePads, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                  </ItemsControl>
                  <TextBlock Style="{StaticResource Text}" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,0,0,8"
                             Text="Noch kein aktiver Controller"
                             Visibility="{Binding HasActivePads, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </StackPanel>

                <!-- Problem: genau eine Meldung + eine Handlung -->
                <Border Style="{StaticResource Divider}" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}" />
                <Grid Margin="20,16,20,18" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="18" Foreground="{DynamicResource Brush.Danger}" />
                  <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Strong}" Text="{Binding ProblemTitle}" />
                    <TextBlock Style="{StaticResource Text.Wrap}" Text="{Binding ProblemText}" Margin="0,3,0,0" />
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Content="Treiber einrichten"
                          Command="{Binding RepairDriverCommand}" VerticalAlignment="Center"
                          Visibility="{Binding CanRepair, Converter={StaticResource BoolToVis}}" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Physische Controller (im Fehlerzustand ausgeblendet: dann zählt nur die eine Handlung oben) -->
            <StackPanel Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
            <Grid>
              <TextBlock Style="{StaticResource Text.Section}" Text="Deine Controller" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding PadsSummary}" HorizontalAlignment="Right"
                         VerticalAlignment="Bottom" Margin="0,0,2,11" />
            </Grid>

            <Border Style="{StaticResource Card.List}" Visibility="{Binding HasPads, Converter={StaticResource BoolToVis}}">
              <ItemsControl ItemsSource="{Binding Pads}" ItemTemplate="{StaticResource PadRow}" Focusable="False" />
            </Border>

            <Border Style="{StaticResource Card}" Padding="24,28"
                    Visibility="{Binding HasPads, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
              <StackPanel HorizontalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Brush.SurfaceSubtle}" HorizontalAlignment="Center">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="18" Foreground="{DynamicResource Brush.TextTertiary}" />
                </Border>
                <TextBlock Style="{StaticResource Text.Strong}" Text="Noch kein Controller verbunden" Margin="0,14,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Text.Wrap}" TextAlignment="Center" MaxWidth="360" Margin="0,6,0,0"
                           Text="Schließe einen Controller per USB oder Bluetooth an. Er wird automatisch erkannt und sofort übernommen." />
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Caption}" Margin="2,12,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasPads, Converter={StaticResource BoolToVis}}"
                       Text="Mit dem Schalter pausierst du einen Controller: Er bleibt verbunden, steuert aber nicht mit." />
            </StackPanel>
          </StackPanel>

          <!-- ================================================= Eingabe -->
          <StackPanel x:Name="PageInput" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="Eingabe" />
            <TextBlock Style="{StaticResource Text.PageLead}"
                       Text="Lege fest, wie die Signale aller Controller zu einem zusammengeführt werden." />

            <TextBlock Style="{StaticResource Text.Section}" Text="Zusammenführung" Margin="2,24,0,10" />
            <Border Style="{StaticResource Card.List}">
              <StackPanel>
                <ui:SettingRow Title="Analog-Sticks" Description="Wie zwei Sticks kombiniert werden.">
                  <Border Style="{StaticResource SegmentHost}">
                    <UniformGrid Rows="1">
                      <RadioButton Style="{StaticResource Segment}" Content="Ganzer Stick" GroupName="stickmode"
                                   IsChecked="{Binding StickMode, Converter={StaticResource Equals}, ConverterParameter=PerStick}" />
                      <RadioButton Style="{StaticResource Segment}" Content="Einzelne Achsen" GroupName="stickmode"
                                   IsChecked="{Binding StickMode, Converter={StaticResource Equals}, ConverterParameter=PerAxis}" />
                    </UniformGrid>
                  </Border>
                </ui:SettingRow>
                <!-- Beide Optionen erklärt; die gewählte ist hervorgehoben -->
                <Grid Margin="20,0,20,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock x:Name="ModeStickName" Style="{StaticResource Text}" FontSize="12.5" Text="Ganzer Stick" Margin="0,0,16,6" />
                  <TextBlock x:Name="ModeStickText" Grid.Column="1" Style="{StaticResource Text.Wrap}" FontSize="12.5" Margin="0,0,0,6"
                             Text="Der stärkere Stick lenkt allein. Ideal, wenn zwei Personen gleichzeitig steuern." />
                  <TextBlock x:Name="ModeAxisName" Grid.Row="1" Style="{StaticResource Text}" FontSize="12.5" Text="Einzelne Achsen" Margin="0,0,16,0" />
                  <TextBlock x:Name="ModeAxisText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Wrap}" FontSize="12.5"
                             Text="Jede Richtung wird für sich verglichen. Eingaben können sich überlagern, etwa zu einer Schräge." />
                </Grid>
                <Border Style="{StaticResource Divider}" />
                <StackPanel Margin="20,14,20,14">
                  <TextBlock Style="{StaticResource Text.Strong}" FontWeight="Medium" Text="Tasten, Trigger und Steuerkreuz" Margin="0,0,0,8" />
                  <ItemsControl Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Ellipse Style="{StaticResource Bullet}" />
                          <TextBlock Grid.Column="1" Style="{StaticResource Text.Wrap}" FontSize="12.5" Text="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.Items>
                      <x:Static Member="ui:SettingsTexts.RuleButtons" />
                      <x:Static Member="ui:SettingsTexts.RuleTriggers" />
                      <x:Static Member="ui:SettingsTexts.RuleDpad" />
                    </ItemsControl.Items>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Section}" Text="Totzone – ab wann eine Eingabe zählt" />
            <Border Style="{StaticResource Card.List}">
              <StackPanel>
                <Grid Margin="20,16,20,14">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Strong}" FontWeight="Medium" Text="Analog-Sticks" />
                    <TextBlock Style="{StaticResource Text.Wrap}" Margin="0,3,0,0"
                               Text="Ignoriert kleine Ausschläge, etwa wenn ein Stick von selbst leicht driftet." />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Style="{StaticResource Text.Strong}" VerticalAlignment="Top" Margin="16,0,0,0">
                    <Run Text="{Binding StickDeadzone, Mode=OneWay}" /><Run Text=" %" />
                  </TextBlock>
                  <Slider Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Minimum="0" Maximum="30"
                          Value="{Binding StickDeadzone}" AutomationProperties.Name="Totzone der Analog-Sticks" />
                </Grid>
                <Border Style="{StaticResource Divider}" />
                <Grid Margin="20,16,20,14">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Strong}" FontWeight="Medium" Text="Trigger" />
                    <TextBlock Style="{StaticResource Text.Wrap}" Margin="0,3,0,0"
                               Text="Leichtes Antippen unterhalb dieser Schwelle zählt nicht." />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Style="{StaticResource Text.Strong}" VerticalAlignment="Top" Margin="16,0,0,0">
                    <Run Text="{Binding TriggerDeadzone, Mode=OneWay}" /><Run Text=" %" />
                  </TextBlock>
                  <Slider Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Minimum="0" Maximum="30"
                          Value="{Binding TriggerDeadzone}" AutomationProperties.Name="Totzone der Trigger" />
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Section}" Text="Achsen umkehren" />
            <Border Style="{StaticResource Card.List}">
              <StackPanel>
                <ui:SettingRow Title="Linker Stick" Description="Bewegungsrichtung spiegeln.">
                  <StackPanel Orientation="Horizontal">
                    <CheckBox Style="{StaticResource Toggle}" Content="Horizontal" IsChecked="{Binding InvertLeftX}" />
                    <CheckBox Style="{StaticResource Toggle}" Content="Vertikal" IsChecked="{Binding InvertLeftY}" Margin="24,0,0,0" />
                  </StackPanel>
                </ui:SettingRow>
                <Border Style="{StaticResource Divider}" />
                <ui:SettingRow Title="Rechter Stick" Description="Etwa für invertierte Kamerasteuerung.">
                  <StackPanel Orientation="Horizontal">
                    <CheckBox Style="{StaticResource Toggle}" Content="Horizontal" IsChecked="{Binding InvertRightX}" />
                    <CheckBox Style="{StaticResource Toggle}" Content="Vertikal" IsChecked="{Binding InvertRightY}" Margin="24,0,0,0" />
                  </StackPanel>
                </ui:SettingRow>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Section}" Text="Reaktionszeit" />
            <Border Style="{StaticResource Card.List}">
              <ui:SettingRow Title="Abfrageintervall">
                <ui:SettingRow.Description>Kürzer heißt schnellere Reaktion bei minimal mehr Rechenlast. Empfohlen: 4 ms.</ui:SettingRow.Description>
                <Border Style="{StaticResource SegmentHost}">
                  <UniformGrid Rows="1">
                    <RadioButton Style="{StaticResource Segment}" MinWidth="58" Content="1 ms" GroupName="poll"
                                 IsChecked="{Binding PollingIntervalMs, Converter={StaticResource Equals}, ConverterParameter=1}" />
                    <RadioButton Style="{StaticResource Segment}" MinWidth="58" Content="2 ms" GroupName="poll"
                                 IsChecked="{Binding PollingIntervalMs, Converter={StaticResource Equals}, ConverterParameter=2}" />
                    <RadioButton Style="{StaticResource Segment}" MinWidth="58" Content="4 ms" GroupName="poll"
                                 IsChecked="{Binding PollingIntervalMs, Converter={StaticResource Equals}, ConverterParameter=4}" />
                    <RadioButton Style="{StaticResource Segment}" MinWidth="58" Content="8 ms" GroupName="poll"
                                 IsChecked="{Binding PollingIntervalMs, Converter={StaticResource Equals}, ConverterParameter=8}" />
                  </UniformGrid>
                </Border>
              </ui:SettingRow>
            </Border>
          </StackPanel>

          <!-- ================================================= Allgemein -->
          <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="Allgemein" />
            <TextBlock Style="{StaticResource Text.PageLead}" Text="Verhalten, Darstellung und technische Details." />

            <TextBlock Style="{StaticResource Text.Section}" Text="Verhalten" Margin="2,24,0,10" />
            <Border Style="{StaticResource Card.List}">
              <StackPanel>
                <ui:SettingRow Title="Vibration weitergeben"
                               Description="Vibration aus Spielen geht an alle aktiven Controller, die sie unterstützen.">
                  <CheckBox Style="{StaticResource Toggle.OnOff}" IsChecked="{Binding RumbleEnabled}" AutomationProperties.Name="Vibration weitergeben" />
                </ui:SettingRow>
                <Border Style="{StaticResource Divider}" />
                <ui:SettingRow Title="Mit Windows starten"
                               Description="Startet unauffällig im Infobereich der Taskleiste.">
                  <CheckBox Style="{StaticResource Toggle.OnOff}" IsChecked="{Binding Autostart}" AutomationProperties.Name="Mit Windows starten" />
                </ui:SettingRow>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Section}" Text="Darstellung" />
            <Border Style="{StaticResource Card.List}">
              <ui:SettingRow Title="Farbschema" Description="Folgt standardmäßig der Windows-Einstellung.">
                <Border Style="{StaticResource SegmentHost}">
                  <UniformGrid Rows="1">
                    <RadioButton Style="{StaticResource Segment}" MinWidth="72" Content="System" GroupName="theme"
                                 IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}" />
                    <RadioButton Style="{StaticResource Segment}" MinWidth="72" Content="Hell" GroupName="theme"
                                 IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}" />
                    <RadioButton Style="{StaticResource Segment}" MinWidth="72" Content="Dunkel" GroupName="theme"
                                 IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}" />
                  </UniformGrid>
                </Border>
              </ui:SettingRow>
            </Border>

            <TextBlock Style="{StaticResource Text.Section}" Text="Technische Details" />
            <Border Style="{StaticResource Card.List}">
              <StackPanel>
                <ui:SettingRow Title="Controller-Treiber (ViGEmBus)" Description="Stellt den virtuellen Xbox 360 Controller bereit.">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,1,8,0" VerticalAlignment="Center">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding DriverOk}" Value="False">
                              <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource Text}" Text="{Binding DriverVersionText}" />
                  </StackPanel>
                </ui:SettingRow>
                <Border Style="{StaticResource Divider}" />
                <ui:SettingRow Title="Anschluss in Windows" Description="Unter dieser Spielernummer sehen Spiele den virtuellen Controller.">
                  <TextBlock Style="{StaticResource Text}" Text="{Binding PlayerText}" />
                </ui:SettingRow>
                <Border Style="{StaticResource Divider}" />
                <ui:SettingRow Title="Gemessene Abfragerate" Description="Wie oft pro Sekunde alle Controller gelesen werden.">
                  <TextBlock Style="{StaticResource Text}" Text="{Binding RateText}" />
                </ui:SettingRow>
                <Border Style="{StaticResource Divider}" />
                <ui:SettingRow Title="Eingabebibliothek (SDL)" Description="Erkennt Xbox-, PlayStation-, Switch- und HID-Controller.">
                  <TextBlock Style="{StaticResource Text}" Text="{Binding SdlVersionText}" />
                </ui:SettingRow>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Section}" Text="Hilfe" />
            <Border Style="{StaticResource Card}" Padding="20,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.SurfaceSubtle}" VerticalAlignment="Top">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource Brush.TextSecondary}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Text.Strong}" Text="Ein Spiel reagiert doppelt?" />
                  <TextBlock Style="{StaticResource Text.Wrap}" Margin="0,4,0,0"
                             Text="Wähle im Spiel den virtuellen Xbox 360 Controller. Hilft das nicht, verbirg die echten Controller mit dem kostenlosen Tool HidHide." />
                </StackPanel>
              </Grid>
            </Border>

            <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="-8,14,0,0" ui:Ui.Icon="&#xE8A7;"
                    Content="Logdatei öffnen" Command="{Binding OpenLogCommand}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
